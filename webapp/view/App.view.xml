<!--
  APP SHELL: Coding Club - The Friday Problem
-->
<mvc:View
  controllerName="workshop.dashboard.controller.App"
  xmlns="sap.m"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns:f="sap.f"
  xmlns:tnt="sap.tnt"
  displayBlock="true"
  height="100%"
>
<!-- 🧩 SHELL START -->
<tnt:ToolPage id="toolPage">
  <tnt:header>
    <f:ShellBar homeIcon="{app>/logo}" title="Coding Club · The Friday Problem Dashboard" />
  </tnt:header>
  <tnt:subHeader>
    <IconTabHeader id="nav" selectedKey="page1" select=".onNavSelect" backgroundDesign="Solid">
      <items>
        <IconTabFilter key="page1" text="The Finding &amp; Solution" icon="sap-icon://hint" />
        <IconTabFilter key="page2" text="Campus-Wide &amp; Promotion Evidence" icon="sap-icon://line-charts" />
        <IconTabFilter key="page3" text="Spring 2027 Schedule &amp; Sponsor Pitch" icon="sap-icon://calendar" />
      </items>
    </IconTabHeader>
  </tnt:subHeader>
  <tnt:mainContents>
    <App id="app" autoFocus="false" />
  </tnt:mainContents>
</tnt:ToolPage>
<!-- 🧩 SHELL END -->
</mvc:View>
