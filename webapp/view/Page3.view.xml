<!--
  PAGE 3: Spring 2027 Schedule & Sponsor Pitch
-->
<mvc:View
  controllerName="workshop.dashboard.controller.Page"
  xmlns="sap.m"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns:f="sap.f"
  xmlns:card="sap.f.cards"
  xmlns:layout="sap.ui.layout"
  xmlns:mc="sap.suite.ui.microchart"
  xmlns:viz="sap.viz.ui5.controls"
  xmlns:viz.data="sap.viz.ui5.data"
  xmlns:viz.feeds="sap.viz.ui5.controls.common.feeds"
  displayBlock="true"
  height="100%"
>
<!-- 🧩 PAGE START -->
<f:DynamicPage id="page3Content" headerExpanded="true" showFooter="false">
  <f:title>
    <f:DynamicPageTitle>
      <f:heading>
        <Title text="Execution Plan: Spring 2027 Room Schedule &amp; Sponsor Renewal" level="H1" wrapping="true" />
      </f:heading>
      <f:expandedContent>
        <Text text="Concrete steps to present to Quillmoor Software this Friday and execute for next semester." />
      </f:expandedContent>
    </f:DynamicPageTitle>
  </f:title>

  <f:content>
    <VBox width="100%">
      <!-- Sponsor Pitch Card -->
      <HBox class="wsRow" renderType="Bare">
        <f:Card width="100%">
          <f:header>
            <card:Header 
              title="Quillmoor Software Sponsor Pitch (Meeting This Friday)" 
              subtitle="Confidential briefing notes for the club president" 
              iconSrc="sap-icon://lead" />
          </f:header>
          <f:content>
            <VBox width="100%" class="sapUiSmallMargin">
              <MessageStrip 
                text="KEY PITCH MESSAGE: Workshops are the club's flagship product (4.49/5 rating). The attendance dip was caused by a room conflict that forced sessions to Friday nights. In Spring 2027, workshops will move to Tuesday 18:00 - 20:00 to restore 85%+ attendance." 
                type="Success" showIcon="true" class="sapUiSmallMarginBottom" />

              <layout:Grid defaultSpan="XL4 L4 M6 S12" class="sapUiSmallMarginTop">
                <VBox>
                  <Title text="1. Student Satisfaction" level="H4" />
                  <Text text="Workshops scored 4.49 / 5.0 in student reviews — higher than Socials (3.97) and Talks (4.27). Students actively love the content." class="sapUiTinyMarginTop" />
                </VBox>
                <VBox>
                  <Title text="2. Demand Stays High" level="H4" />
                  <Text text="94.1% of seats were reserved in advance. Students registered in full; they only dropped out at check-in because of Friday weekend travel." class="sapUiTinyMarginTop" />
                </VBox>
                <VBox>
                  <Title text="3. The Solution Secured" level="H4" />
                  <Text text="Room M105 (40-seat computer lab) is 100% free on Tuesdays. Moving from Friday to Tuesday permanently fixes attendance." class="sapUiTinyMarginTop" />
                </VBox>
              </layout:Grid>
            </VBox>
          </f:content>
        </f:Card>
      </HBox>

      <!-- Room Booking Verification Table -->
      <HBox class="wsRow" renderType="Bare">
        <f:Card width="100%">
          <f:header>
            <card:Header 
              title="Next Semester Room Bookings: Room M105 (Spring 2027)" 
              subtitle="Verified reservations from campus timetable database" 
              iconSrc="sap-icon://calendar" />
          </f:header>
          <f:content>
            <VBox width="100%" class="sapUiSmallMargin">
              <Table items="{/roomAvailabilityM105}">
                <columns>
                  <Column><Text text="Weekday" /></Column>
                  <Column><Text text="Time Slot" /></Column>
                  <Column><Text text="Booking Status" /></Column>
                  <Column><Text text="Booked By" /></Column>
                </columns>
                <items>
                  <ColumnListItem>
                    <cells>
                      <Text text="{weekday}" />
                      <Text text="{start_time} - {end_time}" />
                      <ObjectStatus text="Reserved" state="Warning" />
                      <Text text="{booked_by}" />
                    </cells>
                  </ColumnListItem>
                </items>
              </Table>
              <MessageStrip 
                text="TUESDAY CONFIRMATION: Room M105 has NO bookings on Tuesday. Coding Club will lock in Tuesday 18:00 - 20:00 for Quillmoor Software Workshops." 
                type="Information" showIcon="true" class="sapUiTinyMarginTop" />
            </VBox>
          </f:content>
        </f:Card>
      </HBox>
    </VBox>
  </f:content>
</f:DynamicPage>
<!-- 🧩 PAGE END -->
</mvc:View>
